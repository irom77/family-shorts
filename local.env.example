# Machine-specific paths and the YouTube channel. Copy to local.env (not in git) and fill in.
ARCHIVE="/mnt/c/Users/<you>/Videos/Archive"      # Windows archive folder, as seen from WSL
SOURCES_PAL="$ARCHIVE/<PAL tape captures folder>"
SOURCES_NTSC="$ARCHIVE/<NTSC tape captures folder>"
SHORTS="$ARCHIVE/Shorts"                           # finished shorts, one folder per tape
CHANNEL="<YouTube channel id>"                     # uploads refuse to run on any other channel
